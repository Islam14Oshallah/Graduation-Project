import time
import pandas as pd
from deep_translator import GoogleTranslator, exceptions
from requests.exceptions import ConnectionError, Timeout
import urllib3

def translate_questions(input_file, output_file, checkpoint=100, max_retries=3, delay=1):
    # Load the TSV file
    data = pd.read_csv(input_file, sep='\t', header=None, names=["ID", "Question"])

    # To store translated questions temporarily
    translated_questions = []
    
    for i, question in enumerate(data["Question"], start=1):
        retries = 0
        
        # Check the length of the question
        if len(question) > 5000:
            print(f"Question {i} exceeds the maximum length. Skipping translation.")
            translated_questions.append(question)  # Append the original question
            continue  # Skip to the next question
        
        while retries < max_retries:
            try:
                # Translate the question
                translated_text = GoogleTranslator(source='auto', target='en').translate(question)
                translated_questions.append(translated_text)
                print(f"Translated {i}: {translated_text}")
                time.sleep(delay)  # Delay to avoid API rate limits
                break
            except (ConnectionError, Timeout, urllib3.exceptions.ProtocolError, exceptions.RequestError) as e:
                retries += 1
                print(f"Error: {e}. Retrying {retries}/{max_retries}...")
                time.sleep(2)  # Wait before retrying
        else:
            # If maximum retries are reached, append the original question without translation
            translated_questions.append(question)
            print(f"Failed to translate question {i} after multiple retries. Using original text.")
        
        # Save checkpoint every 100 questions
        if i % checkpoint == 0:
            # Replace the original questions with the translated ones so far
            data["Question"][:i] = translated_questions
            data.to_csv(output_file, sep='\t', index=False, header=False)
            print(f"Checkpoint saved: {i} questions translated and saved to {output_file}")

    # Final save after all translations
    data["Question"][:len(translated_questions)] = translated_questions
    data.to_csv(output_file, sep='\t', index=False, header=False)
    print(f"\nFinal translated file saved as {output_file}")

# Example usage
input_file = 'QQA23_TaskA_test.tsv'  # Replace with your input file path
output_file = 'Transeleted_test.tsv'  # Replace with your desired output file path
translate_questions(input_file, output_file, checkpoint=100)
